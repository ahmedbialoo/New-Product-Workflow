/// <summary>
/// Menu item action that releases an approved expected product to InventTable.
/// </summary>
public class SC_ExpectedReleasedProductReleaseToInvent
{
    public static void main(Args args)
    {
        SC_ExpectedReleasedProduct expectedReleasedProduct;
        FormRun                      callerForm;
        FormDataSource               formDataSource;
        ItemId                       releasedItemId;

        expectedReleasedProduct = args.record();

        if (!expectedReleasedProduct.RecId)
        {
            throw error("Select a saved expected product before release.");
        }

        releasedItemId = SC_ExpectedReleasedProductInventRelease::release(expectedReleasedProduct);

        info(strFmt("Released product %1 created.", releasedItemId));

        callerForm = args.caller() as FormRun;

        if (callerForm)
        {
            formDataSource = callerForm.dataSource(formDataSourceStr(SC_NewProductForm, SC_ExpectedReleasedProduct));

            if (formDataSource)
            {
                formDataSource.research(true);
            }

            if (callerForm.name() == formStr(SC_NewProductForm))
            {
                callerForm.updateActionButtonStates();
            }
        }
    }

}
