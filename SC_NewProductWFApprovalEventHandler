    public void completed(WorkflowElementEventArgs _workflowElementEventArgs)
    {
        WorkflowContext                 workflowContext;
        WorkflowTrackingStatusTable     trackingStatus;
        WorkflowWorkItemTable           workItem;

        SC_ExpectedReleasedProduct      expectedProduct;

        WorkflowCorrelationId           correlationId;

        int totalApprovals;
        int completedApprovals;

        workflowContext = _workflowElementEventArgs.parmWorkflowContext();

        expectedProduct = SC_ExpectedReleasedProduct::find(
            workflowContext.parmRecId());

        if (!expectedProduct)
        {
            return;
        }

        // Get workflow correlationId
        select firstOnly trackingStatus
            where trackingStatus.ContextRecId == workflowContext.parmRecId();

        correlationId = trackingStatus.CorrelationId;

        // Count all approval work items
        while select workItem
            where workItem.CorrelationId == correlationId
        {
            totalApprovals++;

            if (workItem.Status == WorkflowWorkItemStatus::Completed)
            {
                completedApprovals++;
            }
        }

        // Current approval is the LAST approval
        // because current completed event fires BEFORE current item becomes completed in DB
        if ((completedApprovals + 1) >= totalApprovals)
        {
            // Validate ItemId before final approval
            if (!expectedProduct.ItemId)
            {
                throw warning("Please assign the item number before final approval.");
            }

            // Final approval successful
            SC_ExpectedReleasedProduct::updateWorkflowStatus(
                workflowContext.parmRecId(),
                SC_WorkflowStatus::Approved);
        }
        else
        {
            // Still under approval chain
            SC_ExpectedReleasedProduct::updateWorkflowStatus(
                workflowContext.parmRecId(),
                SC_WorkflowStatus::InReview);
        }
    }

